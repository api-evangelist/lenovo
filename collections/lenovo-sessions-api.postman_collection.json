                "sessions"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "description": "Hostname or IP address of the XClarity Administrator server",
                  "type": "any",
                  "value": "{{xclarityHost}}",
                  "key": "xclarityHost"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
